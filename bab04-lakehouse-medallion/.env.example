# Salin ke .env lalu ganti nilai contoh. Jangan commit .env.
# Server lab: BIND_ADDR=10.100.21.22
BIND_ADDR=127.0.0.1

# Kredensial RustFS lab (nilai contoh, ganti sebelum dipakai di server bersama)
S3_ACCESS_KEY=lab04admin
S3_SECRET_KEY=ganti-sandi-rustfs-lab04
S3_BUCKET=lake

# Pepper tokenization PII di silver (rahasia; nilai contoh)
TOKEN_PEPPER=ganti-pepper-lab04

# Opsional: salin bronze dari platform end-to-end yang sedang menyala (read-only).
# Contoh: PLATFORM_S3_ENDPOINT=http://host.docker.internal:52003 dan kunci RustFS platform.
PLATFORM_S3_ENDPOINT=
PLATFORM_S3_ACCESS_KEY=
PLATFORM_S3_SECRET_KEY=
PLATFORM_S3_BUCKET=lake
