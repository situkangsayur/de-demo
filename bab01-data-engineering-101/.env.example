# Salin ke .env. Tidak ada rahasia di lab ini.
BIND_ADDR=127.0.0.1          # server lab: 10.100.21.22
FLUSH_DETIK=5                # ingestor menulis bronze tiap N detik (micro-batch)
BATCH_DETIK=15               # job silver + gold tiap N detik (di platform: DAG harian Airflow)
# Opsional: API aliran data platform (platform/ops, port 52001) bila platform sedang menyala.
# Pakai alamat yang terjangkau dari container, mis. http://10.100.21.22:52001 di server lab.
PLATFORM_FLOW_URL=
