# Salin ke .env. Nilai di bawah hanya contoh.
BIND_ADDR=127.0.0.1          # server lab: 10.100.21.22
N_TRANSAKSI=300000           # jumlah transaksi sintetis saat start (bisa diubah dari UI)
# Opsional: baca bronze transaksi dari RustFS platform (hanya baca) bila platform menyala.
# Endpoint harus terjangkau dari container, mis. http://10.100.21.22:52003 di server lab.
PLATFORM_S3_ENDPOINT=
PLATFORM_S3_ACCESS_KEY=
PLATFORM_S3_SECRET_KEY=
PLATFORM_S3_BUCKET=lake
