# Variabel bagian data (penulis B). Koordinator menggabungkannya ke platform/.env.example.
# Salin ke platform/.env dan GANTI semua nilai contoh. Nilai di bawah hanya contoh, bukan secret asli.
BIND_ADDR=127.0.0.1

# Object storage (sama dengan bagian ops; bucket dibuat ops)
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=ganti-akses-rustfs
S3_SECRET_KEY=ganti-rahasia-rustfs-minimal-8
S3_BUCKET=lake

# PostgreSQL metadata Airflow + katalog Iceberg (milik bagian data)
DATA_PG_PASSWORD=ganti-sandi-postgres-data

# Airflow (UI http://BIND_ADDR:52010)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=ganti-sandi-airflow
AIRFLOW_JWT_SECRET=ganti-rahasia-jwt-panjang-acak
AIRFLOW_API_SECRET_KEY=ganti-rahasia-api-panjang-acak

# ClickHouse (HTTP http://BIND_ADDR:52011)
CLICKHOUSE_USER=de
CLICKHOUSE_PASSWORD=ganti-sandi-clickhouse

# Pepper tokenization PII (NIK, no HP, alamat). Rahasia: token tidak bisa dibalik tanpa nilai ini.
TOKEN_PEPPER=ganti-pepper-acak-panjang

# Ambang data quality (opsional)
DQ_LATENSI_MAKS_MENIT=60
# 1 = muat awal otomatis saat platform menyala (run penuh + jadwal harian aktif)
MUAT_AWAL=1
