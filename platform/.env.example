# .env platform de-demo = gabungan variabel ops (penulis A) dan data (penulis B). Salin menjadi .env; ganti semua nilai contoh.

# Variabel bagian ops (penulis A). Salin isinya ke platform/.env (koordinator menggabungkan dengan
# variabel bagian data). Nilai di bawah hanya contoh untuk demo lokal, bukan kredensial asli.

# Alamat ikat port host. Server lab: 10.100.21.22 (wg0).
BIND_ADDR=127.0.0.1

# Lokasi repo sister-hpc-demo, RELATIF TERHADAP FOLDER platform/ (tempat compose.yaml) atau absolut.
# Dua repo di-clone berdampingan: <induk>/de-demo/platform -> ../../sister-hpc-demo
SISTER_DIR=../../sister-hpc-demo

# Dipakai juga oleh aplikasi Sister (harus sama dengan nilai di .env Sister bila ada).
POSTGRES_PASSWORD=changeme
APISIX_KEY=changeme-storefront-key

# Role PostgreSQL dengan hak REPLICATION untuk Debezium (dibuat oleh aplikasi Sister).
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=changeme-debezium

# RustFS (S3-compatible). Dipakai RustFS, ingestor, dan pipeline penulis B.
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=changeme-lake-secret
S3_BUCKET=lake

# Ingestor: tulis batch bronze tiap N detik atau M pesan (mana yang lebih dulu).
INGEST_FLUSH_SECONDS=10
INGEST_FLUSH_MAX=2000

# Variabel bagian data (penulis B). Koordinator menggabungkannya ke platform/.env.example.
# Salin ke platform/.env dan GANTI semua nilai contoh. Nilai di bawah hanya contoh, bukan secret asli.

# Object storage (sama dengan bagian ops; bucket dibuat ops)
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=ganti-akses-rustfs
S3_SECRET_KEY=ganti-rahasia-rustfs-minimal-8
S3_BUCKET=lake

# PostgreSQL metadata Airflow + katalog Iceberg (milik bagian data)
DATA_PG_PASSWORD=ganti-sandi-postgres-data

# Airflow (UI http://BIND_ADDR:52010)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=ganti-sandi-airflow
AIRFLOW_JWT_SECRET=ganti-rahasia-jwt-panjang-acak
AIRFLOW_API_SECRET_KEY=ganti-rahasia-api-panjang-acak

# ClickHouse (HTTP http://BIND_ADDR:52011)
CLICKHOUSE_USER=de
CLICKHOUSE_PASSWORD=ganti-sandi-clickhouse

# Pepper tokenization PII (NIK, no HP, alamat). Rahasia: token tidak bisa dibalik tanpa nilai ini.
TOKEN_PEPPER=ganti-pepper-acak-panjang

# Ambang data quality (opsional)
DQ_LATENSI_MAKS_MENIT=60
# 1 = muat awal otomatis saat platform menyala (run penuh + jadwal harian aktif)
MUAT_AWAL=1
